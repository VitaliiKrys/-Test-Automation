{
  "info": {
    "_postman_id": "195ae28b-1806-4f3b-9296-1f993a1241a9",
    "name": "Laboratory 5 - Orders API - Variant 9",
    "description": "Automated Postman/Newman checks for Idempotency-Key. Start server before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"bob@example.com\", \"password\": \"Secret123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token',pm.response.json().accessToken);",
              "pm.collectionVariables.set('idempotencyKey','LAB5-'+Date.now()+'-'+Math.floor(Math.random()*1000000));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create with key (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"sku\": \"SKU-A\", \"price\": 500, \"qty\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('new order: 201',()=>pm.response.to.have.status(201));",
              "pm.test('total = 560',()=>pm.expect(pm.response.json().total).to.eql(560));",
              "pm.collectionVariables.set('orderId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Repeat with same key (200, same id)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"sku\": \"SKU-A\", \"price\": 500, \"qty\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('repeat: 200',()=>pm.response.to.have.status(200));",
              "pm.test('same order id',()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 GET created order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('get: 200',()=>pm.response.to.have.status(200));",
              "pm.test('same id',()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Conflict with same key but another payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"sku\": \"SKU-B\", \"price\": 700, \"qty\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('conflict: 409',()=>pm.response.to.have.status(409));",
              "pm.test('conflict code',()=>pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Перевірка без дублювання поточного замовлення",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('list: 200',()=>pm.response.to.have.status(200));",
              "pm.test('current order exists exactly once',()=>{",
              "  const expectedId=pm.collectionVariables.get('orderId');",
              "  const matching=pm.response.json().filter(order=>order.id===expectedId);",
              "  pm.expect(matching.length).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": "LAB5-VARIANT9-KEY"
    }
  ]
}
