{
  "name": "laboratorna-6-variant9-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Лабораторна №6: Playwright, локатори, автоочікування, варіант 9",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:variant9": "playwright test tests/variant9.spec.ts",
    "test:list": "playwright test --list",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:diagnostic": "playwright test --config=playwright.diagnostic.config.ts --project=chromium",
    "report": "playwright show-report",
    "experiment": "node scripts/run-experiments.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
